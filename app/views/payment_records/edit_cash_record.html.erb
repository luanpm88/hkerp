<%#
  Edit an existing Cash - Pay / Cash - Receive record.

  @direction comes from the record's own amount sign, so opening the wrong
  screen is impossible — the record decides which form it gets. The direction
  is also immutable on save (see PaymentRecord#normalise_cash_direction).
%>
<% is_pay    = (@direction == 'pay') %>
<% title     = PaymentRecord.cash_direction_label(@direction) %>
<% list_path = is_pay ? cash_pays_payment_records_path(tab_page: 1) : cash_receives_payment_records_path(tab_page: 1) %>
<% post_url  = update_cash_record_payment_record_path(@payment_record) %>

<ul class="breadcrumb">
    <li>
        <p>YOU ARE HERE</p>
    </li>
    <li><%= link_to title, list_path %></li>
    <li><%= link_to "Edit record ##{@payment_record.id}", "javascript:;", :class => "active" %></li>
</ul>

<div class="page-title">
    <i class="<%= is_pay ? 'icon-arrow-up' : 'icon-arrow-down' %>"></i>
    <h3>Edit <span class="semi-bold"><%= title %></span> Record</h3>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="grid simple">
            <div class="grid-body">
                <%= render 'cash_form', direction: @direction, url: post_url %>
            </div>
        </div>
    </div>
</div>
